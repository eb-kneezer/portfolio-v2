---
import { site } from "@/data/site";
---

<footer class="border-t border-border">
  <div class="reading-column flex flex-wrap items-center justify-between gap-x-6 gap-y-1 py-7 text-sm text-muted-foreground">
    <div>
      <p>
        © {new Date().getFullYear()} {site.name}
      </p>
    </div>
    <a href="#main" class="inline-flex min-h-6 items-center gap-1 hover:text-foreground">
      Back to top <span aria-hidden="true">↑</span>
    </a>
  </div>
</footer>
